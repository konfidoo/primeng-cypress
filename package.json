{
  "name": "@konfidoo2/primeng-cypress",
  "author": "Konfidoo (https://konfidoo.de)",
  "description": "Provides Cypress test helpers for PrimeNG components ",
  "homepage": "https://github.com/konfidoo/primeng-cypress",
  "version": "1.0.2",
  "keywords": [
    "primeng",
    "cypress",
    "testing",
    "angular"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:component && npm run test:e2e",
    "build:lib": "tsc -p tsconfig.lib.json && cp src/commands/cypress.d.ts lib/cypress.d.ts && (echo '/// <reference path=\"./cypress.d.ts\" />' && cat lib/index.d.ts) > lib/index.d.ts.tmp && mv lib/index.d.ts.tmp lib/index.d.ts",
    "prepare": "npm run build:lib",
    "test:component": "cypress run --component --browser chrome",
    "test:e2e": "start-server-and-test \"ng serve --host 127.0.0.1 --port 4200\" http-get://127.0.0.1:4200 \"cypress run --e2e --browser chrome\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "packageManager": "npm@11.15.0",
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cdk": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@primeuix/themes": "^3.1.0",
    "@types/jquery": "^3.5.33",
    "@types/mocha": "^10.0.10",
    "cypress": "^16.3.0",
    "jsdom": "^27.1.0",
    "primeng": "^22.1.5",
    "rxjs": "~7.8.0",
    "start-server-and-test": "^3.0.13",
    "tslib": "^2.3.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
